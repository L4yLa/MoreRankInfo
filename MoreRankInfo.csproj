<Project Sdk="Microsoft.NET.Sdk">

  <!--
    対象ゲームバージョン（BSTarget）は 1.44.1 のみ。BSTarget は Directory.Build.props で決まる。
  -->
  <PropertyGroup>
    <OutputPath>bin\$(BSTarget)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(BSTarget)\$(Configuration)\</IntermediateOutputPath>
    <ManifestPath>Manifests\$(BSTarget)\manifest.json</ManifestPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- BSIPA は末尾が .manifest.json の埋め込みリソースを探すため、名前は固定する -->
    <None Remove="Manifests\**" />
    <EmbeddedResource Include="Manifests\$(BSTarget)\manifest.json" LogicalName="MoreRankInfo.manifest.json" />
    <None Remove="UI\Settings.bsml" />
    <EmbeddedResource Include="UI\Settings.bsml" LogicalName="MoreRankInfo.UI.Settings.bsml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BeatSaberModdingTools.Tasks" Version="2.0.0-beta7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="Main">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\Main.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="HMUI">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\HMUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="BeatSaber.ViewSystem">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\BeatSaber.ViewSystem.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="BGLib.AppFlow">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\BGLib.AppFlow.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="OculusStudios.Platform.Core">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\OculusStudios.Platform.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\Unity.TextMeshPro.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Zenject">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\Zenject.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Zenject-usage">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\Zenject-usage.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="IPA.Loader">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\IPA.Loader.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(BeatSaberDir)\Libs\Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="BSML">
      <HintPath>$(BeatSaberDir)\Plugins\BSML.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SiraUtil">
      <HintPath>$(BeatSaberDir)\Plugins\SiraUtil.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- ================= ビルド前チェック ================= -->
  <Target Name="MRI_ValidateTarget" BeforeTargets="BeforeBuild">
    <Error Condition="'$(BSTarget)' != '1.44.1'"
           Text="Unsupported BSTarget '$(BSTarget)'. Only 1.44.1 is supported." />
    <Error Condition="!Exists('$(ManifestPath)')"
           Text="Manifest not found: $(ManifestPath)" />

    <!-- 参照先のゲームフォルダが対象バージョンと一致するか（BeatSaberVersion.txt 例: 1.44.1_20239） -->
    <PropertyGroup>
      <_MriGameVersionFile>$(BeatSaberDir)\BeatSaberVersion.txt</_MriGameVersionFile>
      <_MriGameVersionRaw Condition="Exists('$(_MriGameVersionFile)')">$([System.IO.File]::ReadAllText('$(_MriGameVersionFile)').Trim())</_MriGameVersionRaw>
      <_MriGameVersion Condition="'$(_MriGameVersionRaw)' != ''">$([System.Text.RegularExpressions.Regex]::Replace('$(_MriGameVersionRaw)', '_.*$', ''))</_MriGameVersion>
    </PropertyGroup>
    <Error Condition="'$(_MriGameVersion)' != '' AND '$(_MriGameVersion)' != '$(BSTarget)'"
           Text="BeatSaberDir '$(BeatSaberDir)' is game version $(_MriGameVersion), but BSTarget is $(BSTarget). Point BeatSaberDir to a $(BSTarget) instance (see MoreRankInfo.csproj.user)." />
    <Warning Condition="'$(_MriGameVersion)' == ''"
             Text="BeatSaberVersion.txt was not found in BeatSaberDir '$(BeatSaberDir)'; the game version could not be verified." />
    <Message Importance="high" Text="MoreRankInfo: BSTarget=$(BSTarget), BeatSaberDir=$(BeatSaberDir)" />
  </Target>

</Project>
