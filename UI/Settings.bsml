<settings-container xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xsi:noNamespaceSchemaLocation='https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd'>
  <increment-setting text='Date change hour' value='date-change-hour' min='0' max='23' increment='1' integer-only='true' apply-on-change='true'
                     hover-hint='"Today" starts at this hour (0-23). Default: 3 (3:00 AM).' />
  <toggle-setting text='Show ranks' value='show-ranks' apply-on-change='true'
                  hover-hint='Show the global / country rank line.' />
  <slider-setting text='Max font size' value='font-size' min='2' max='12' increment='0.5' apply-on-change='true'
                  hover-hint='Upper limit of the LastPlayed text size (other lines are smaller). Text shrinks automatically to fit the leaderboard width.' />
  <slider-setting text='Vertical offset' value='offset-y' min='-40' max='40' increment='1' apply-on-change='true'
                  hover-hint='Moves the text up (+) or down (-).' />
</settings-container>
